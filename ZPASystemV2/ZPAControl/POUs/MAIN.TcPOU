<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="MAIN" Id="{13190580-4d30-4ce7-8b2a-cbdcde2d3138}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
// Local Control Panel I/O
    stControlPanel_In   AT %I* : ST_ControlPanel_In;
    stControlPanel_Out  AT %Q* : ST_ControlPanel_Out;
    
    // =========================================================================
    // 1. RAW HARDWARE BYTE ARRAYS (Updated to 64 Bytes / 512 bits)
    // =========================================================================
    // Conveyor A (8 Modules)
    stA1_InBytes  AT %I* : ARRAY[0..63] OF BYTE; // Match 512-bit hardware size
    stA1_OutBytes AT %Q* : ARRAY[0..63] OF BYTE; // Check output size (16 or 32 Bytes)
    stA2_InBytes  AT %I* : ARRAY[0..63] OF BYTE;
    stA2_OutBytes AT %Q* : ARRAY[0..63] OF BYTE;
    stA3_InBytes  AT %I* : ARRAY[0..63] OF BYTE;
    stA3_OutBytes AT %Q* : ARRAY[0..63] OF BYTE;
    stA4_InBytes  AT %I* : ARRAY[0..63] OF BYTE;
    stA4_OutBytes AT %Q* : ARRAY[0..63] OF BYTE;
    stA5_InBytes  AT %I* : ARRAY[0..63] OF BYTE;
    stA5_OutBytes AT %Q* : ARRAY[0..63] OF BYTE;
    stA6_InBytes  AT %I* : ARRAY[0..63] OF BYTE;
    stA6_OutBytes AT %Q* : ARRAY[0..63] OF BYTE;
    stA7_InBytes  AT %I* : ARRAY[0..63] OF BYTE;
    stA7_OutBytes AT %Q* : ARRAY[0..63] OF BYTE;
    stA8_InBytes  AT %I* : ARRAY[0..63] OF BYTE;
    stA8_OutBytes AT %Q* : ARRAY[0..63] OF BYTE;

    // Conveyor B (4 Modules)
    stB1_InBytes  AT %I* : ARRAY[0..63] OF BYTE;
    stB1_OutBytes AT %Q* : ARRAY[0..63] OF BYTE;
    stB2_InBytes  AT %I* : ARRAY[0..63] OF BYTE;
    stB2_OutBytes AT %Q* : ARRAY[0..63] OF BYTE;
    stB3_InBytes  AT %I* : ARRAY[0..63] OF BYTE;
    stB3_OutBytes AT %Q* : ARRAY[0..63] OF BYTE;
    stB4_InBytes  AT %I* : ARRAY[0..63] OF BYTE;
    stB4_OutBytes AT %Q* : ARRAY[0..63] OF BYTE;

    // =========================================================================
    // 2. STRUCTURED PLC LOGIC VARIABLES (Used in ZPA Logic)
    // =========================================================================
    stA1_In : ST_IBE03B_Inputs; stA1_Out : ST_IBE03B_Outputs;
    stA2_In : ST_IBE03B_Inputs; stA2_Out : ST_IBE03B_Outputs;
    stA3_In : ST_IBE03B_Inputs; stA3_Out : ST_IBE03B_Outputs;
    stA4_In : ST_IBE03B_Inputs; stA4_Out : ST_IBE03B_Outputs;
    stA5_In : ST_IBE03B_Inputs; stA5_Out : ST_IBE03B_Outputs;
    stA6_In : ST_IBE03B_Inputs; stA6_Out : ST_IBE03B_Outputs;
    stA7_In : ST_IBE03B_Inputs; stA7_Out : ST_IBE03B_Outputs;
    stA8_In : ST_IBE03B_Inputs; stA8_Out : ST_IBE03B_Outputs;

    stB1_In : ST_IBE03B_Inputs; stB1_Out : ST_IBE03B_Outputs;
    stB2_In : ST_IBE03B_Inputs; stB2_Out : ST_IBE03B_Outputs;
    stB3_In : ST_IBE03B_Inputs; stB3_Out : ST_IBE03B_Outputs;
    stB4_In : ST_IBE03B_Inputs; stB4_Out : ST_IBE03B_Outputs;
	
    // =========================================================================
    // 2. SYSTEM CONTROLLER & FAULT AGGREGATION
    // =========================================================================
    fbSystemControl            : FB_SystemControl;
    bAnyFault                  : BOOL;
    bTandem                    : BOOL; // Active Tandem Mode Flag

    // =========================================================================
    // 3. ZPA ZONE FUNCTION BLOCKS (18 Total Zones)
    // =========================================================================
    // Conveyor A Zones (12 Zones across 4 Conveyor Sections)
    fbZoneA1                   : FB_ZPA_Zone;
    fbZoneA2                   : FB_ZPA_Zone;
    fbZoneA3                   : FB_ZPA_Zone;
    fbZoneA4                   : FB_ZPA_Zone;
    fbZoneA5                   : FB_ZPA_Zone;
    fbZoneA6                   : FB_ZPA_Zone;
    fbZoneA7                   : FB_ZPA_Zone;
    fbZoneA8                   : FB_ZPA_Zone;
    fbZoneA9                   : FB_ZPA_Zone;
    fbZoneA10                  : FB_ZPA_Zone;
    fbZoneA11                  : FB_ZPA_Zone;
    fbZoneA12                  : FB_ZPA_Zone;

    // Conveyor B Zones (6 Zones across 2 Conveyor Sections)
    fbZoneB1                   : FB_ZPA_Zone;
    fbZoneB2                   : FB_ZPA_Zone;
    fbZoneB3                   : FB_ZPA_Zone;
    fbZoneB4                   : FB_ZPA_Zone;
    fbZoneB5                   : FB_ZPA_Zone;
    fbZoneB6                   : FB_ZPA_Zone;
	
	bInfeedLatchedA1 		   : BOOL; // Latches Machine X transfer signal until Zone A1 sensor is reached
    bInfeedLatchedB1 		   : BOOL; // Latches Gravity Roller Y pull signal until Zone B1 sensor is reached
	
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[



// =========================================================================

// STEP 1: FAULT AGGREGATION & MASTER SYSTEM CONTROL

// =========================================================================

bAnyFault := fbZoneA1.bJamFault  OR fbZoneA2.bJamFault  OR fbZoneA3.bJamFault  OR

             fbZoneA4.bJamFault  OR fbZoneA5.bJamFault  OR fbZoneA6.bJamFault  OR

             fbZoneA7.bJamFault  OR fbZoneA8.bJamFault  OR fbZoneA9.bJamFault  OR

             fbZoneA10.bJamFault OR fbZoneA11.bJamFault OR fbZoneA12.bJamFault OR

             fbZoneB1.bJamFault  OR fbZoneB2.bJamFault  OR fbZoneB3.bJamFault  OR

             fbZoneB4.bJamFault  OR fbZoneB5.bJamFault  OR fbZoneB6.bJamFault  OR

             stA1_In.bErrMotorA_Stalled OR stA1_In.bErrMotorB_Stalled OR

             stA2_In.bErrMotorA_Stalled OR stA3_In.bErrMotorA_Stalled OR

             stA3_In.bErrMotorB_Stalled OR stA4_In.bErrMotorA_Stalled OR

             stA5_In.bErrMotorA_Stalled OR stA5_In.bErrMotorB_Stalled OR

             stA6_In.bErrMotorA_Stalled OR stA7_In.bErrMotorA_Stalled OR

             stA7_In.bErrMotorB_Stalled OR stA8_In.bErrMotorA_Stalled OR

             stB1_In.bErrMotorA_Stalled OR stB1_In.bErrMotorB_Stalled OR

             stB2_In.bErrMotorA_Stalled OR stB3_In.bErrMotorA_Stalled OR

             stB3_In.bErrMotorB_Stalled OR stB4_In.bErrMotorA_Stalled;



fbSystemControl(

    bStartBtn     := stControlPanel_In.bStartBtn,

    bStopBtn      := NOT stControlPanel_In.bStopBtn,

    bTandemSwitch := stControlPanel_In.bTandemSwitch,

    bAnyZoneFault := bAnyFault

);



stControlPanel_Out.bStartLED := fbSystemControl.bStartLED;

stControlPanel_Out.bStopLED  := fbSystemControl.bStopLED;

bTandem                     := fbSystemControl.bTandemModeActive;

// =========================================================================
// INFEED LATCHING LOGIC (Holds arrival high for small boxes)
// =========================================================================

// --- Conveyor A Infeed Latch ---
// Set latch when external infeed sensor is tripped
IF stA1_In.bRemoteIn1 THEN
    bInfeedLatchedA1 := TRUE;
// Reset latch once box reaches Zone A1's photo-eye or system is disabled
ELSIF stA1_In.bSensorA OR fbZoneA1.bOccupied OR NOT fbSystemControl.bSystemEnable THEN
    bInfeedLatchedA1 := FALSE;
END_IF;


// =========================================================================
// STEP 2: CONVEYOR A ZPA CHAIN (12 ZONES)
// =========================================================================

// --- ZONE A1 (Module A1, Motor A) ---
fbZoneA1(
    bEnable             := fbSystemControl.bSystemEnable,
    bReset              := fbSystemControl.bResetFaults,
    bTandemMode         := bTandem,
    bIsTandemSlave      := FALSE,
    bPE                 := stA1_In.bSensorA,
    bUpstreamArrival    := bInfeedLatchedA1, // <--- Uses latched infeed signal
    bDownstreamOccupied := SEL(bTandem, fbZoneA2.bOccupied, fbZoneA3.bOccupied),
    bDownstreamReady    := SEL(bTandem, fbZoneA2.bReadyToReceive, fbZoneA3.bReadyToReceive),
    bTandemSlavePE      := stA2_In.bSensorA
);

// --- ZONE A2 (Module A2, Motor A) ---
fbZoneA2(
    bEnable             := fbSystemControl.bSystemEnable,
    bTandemMode         := bTandem,
    bIsTandemSlave      := TRUE,
    bPE                 := stA2_In.bSensorA,
    bUpstreamArrival    := fbZoneA1.bOccupied,
    bDownstreamOccupied := fbZoneA3.bOccupied,
    bDownstreamReady    := fbZoneA3.bReadyToReceive,
    bTandemMasterRun    := fbZoneA1.bRunMotor,
	bReset := fbSystemControl.bResetFaults
);

// --- ZONE A3 (Module A2, Motor B) ---
fbZoneA3(
    bEnable             := fbSystemControl.bSystemEnable,
    bTandemMode         := bTandem,
    bIsTandemSlave      := FALSE,
    bPE                 := stA2_In.bSensorB,
    bUpstreamArrival    := fbZoneA2.bOccupied,
    bDownstreamOccupied := SEL(bTandem, fbZoneA4.bOccupied, fbZoneA5.bOccupied),
    bDownstreamReady    := SEL(bTandem, fbZoneA4.bReadyToReceive, fbZoneA5.bReadyToReceive),
    bTandemSlavePE      := stA3_In.bSensorA,
	bReset := fbSystemControl.bResetFaults
);

// --- ZONE A4 (Module A3, Motor A) ---
fbZoneA4(
    bEnable             := fbSystemControl.bSystemEnable,
    bTandemMode         := bTandem,
    bIsTandemSlave      := TRUE,
    bPE                 := stA3_In.bSensorA,
    bUpstreamArrival    := fbZoneA3.bOccupied,
    bDownstreamOccupied := fbZoneA5.bOccupied,
    bDownstreamReady    := fbZoneA5.bReadyToReceive,
    bTandemMasterRun    := fbZoneA3.bRunMotor,
	bReset := fbSystemControl.bResetFaults
);

// --- ZONE A5 (Module A4, Motor A) ---
fbZoneA5(
    bEnable             := fbSystemControl.bSystemEnable,
    bTandemMode         := bTandem,
    bIsTandemSlave      := FALSE,
    bPE                 := stA4_In.bSensorA,
    bUpstreamArrival    := fbZoneA4.bOccupied,
    bDownstreamOccupied := SEL(bTandem, fbZoneA6.bOccupied, fbZoneA7.bOccupied),
    bDownstreamReady    := SEL(bTandem, fbZoneA6.bReadyToReceive, fbZoneA7.bReadyToReceive),
    bTandemSlavePE      := stA4_In.bSensorB,
	bReset := fbSystemControl.bResetFaults
);

// --- ZONE A6 (Module A4, Motor B) ---
fbZoneA6(
    bEnable             := fbSystemControl.bSystemEnable,
    bTandemMode         := bTandem,
    bIsTandemSlave      := TRUE,
    bPE                 := stA4_In.bSensorB,
    bUpstreamArrival    := fbZoneA5.bOccupied,
    bDownstreamOccupied := fbZoneA7.bOccupied,
    bDownstreamReady    := fbZoneA7.bReadyToReceive,
    bTandemMasterRun    := fbZoneA5.bRunMotor,
	bReset := fbSystemControl.bResetFaults
);

// --- ZONE A7 (Module A5, Motor A) ---
fbZoneA7(
    bEnable             := fbSystemControl.bSystemEnable,
    bTandemMode         := bTandem,
    bIsTandemSlave      := FALSE,
    bPE                 := stA5_In.bSensorA,
    bUpstreamArrival    := fbZoneA6.bOccupied,
    bDownstreamOccupied := SEL(bTandem, fbZoneA8.bOccupied, fbZoneA9.bOccupied),
    bDownstreamReady    := SEL(bTandem, fbZoneA8.bReadyToReceive, fbZoneA9.bReadyToReceive),
    bTandemSlavePE      := stA6_In.bSensorA,
	bReset := fbSystemControl.bResetFaults
);

// --- ZONE A8 (Module A6, Motor A) ---
fbZoneA8(
    bEnable             := fbSystemControl.bSystemEnable,
    bTandemMode         := bTandem,
    bIsTandemSlave      := TRUE,
    bPE                 := stA6_In.bSensorA,
    bUpstreamArrival    := fbZoneA7.bOccupied,
    bDownstreamOccupied := fbZoneA9.bOccupied,
    bDownstreamReady    := fbZoneA9.bReadyToReceive,
    bTandemMasterRun    := fbZoneA7.bRunMotor
);

// --- ZONE A9 (Module A6, Motor B) ---
fbZoneA9(
    bEnable             := fbSystemControl.bSystemEnable,
    bTandemMode         := bTandem,
    bIsTandemSlave      := FALSE,
    bPE                 := stA6_In.bSensorB,
    bUpstreamArrival    := fbZoneA8.bOccupied,
    bDownstreamOccupied := SEL(bTandem, fbZoneA10.bOccupied, fbZoneA11.bOccupied),
    bDownstreamReady    := SEL(bTandem, fbZoneA10.bReadyToReceive, fbZoneA11.bReadyToReceive),
    bTandemSlavePE      := stA7_In.bSensorA,
	bReset := fbSystemControl.bResetFaults
);

// --- ZONE A10 (Module A7, Motor A) ---
fbZoneA10(
    bEnable             := fbSystemControl.bSystemEnable,
    bTandemMode         := bTandem,
    bIsTandemSlave      := TRUE,
    bPE                 := stA7_In.bSensorA,
    bUpstreamArrival    := fbZoneA9.bOccupied,
    bDownstreamOccupied := fbZoneA11.bOccupied,
    bDownstreamReady    := fbZoneA11.bReadyToReceive,
    bTandemMasterRun    := fbZoneA9.bRunMotor,
	bReset := fbSystemControl.bResetFaults
);

// --- ZONE A11 (Module A8, Motor A) ---
fbZoneA11(
    bEnable             := fbSystemControl.bSystemEnable,
    bTandemMode         := bTandem,
    bIsTandemSlave      := FALSE,
    bPE                 := stA8_In.bSensorA,
    bUpstreamArrival    := fbZoneA10.bOccupied,
    bDownstreamOccupied := SEL(bTandem, fbZoneA12.bOccupied, TRUE),                           // In Tandem Mode, EOL is occupied
    bDownstreamReady    := SEL(bTandem, fbZoneA12.bReadyToReceive, stControlPanel_In.bFootswitch1), // In Tandem Mode, wait for footswitch
    bTandemSlavePE      := stA8_In.bSensorB
);

// --- ZONE A12 (Module A8, Motor B) --- Discharge Zone
fbZoneA12(
    bEnable             := fbSystemControl.bSystemEnable,
    bTandemMode         := bTandem,
    bIsTandemSlave      := SEL(bTandem, FALSE, TRUE),
    bPE                 := stA8_In.bSensorB,
    bJogOverride        := stControlPanel_In.bFootswitch1,
    bUpstreamArrival    := fbZoneA11.bOccupied,
    bDownstreamOccupied := TRUE,
    bDownstreamReady    := stControlPanel_In.bFootswitch1,
    bTandemMasterRun    := fbZoneA11.bRunMotor,
    tStopDelay          := T#0S,
	bReset := fbSystemControl.bResetFaults
);

// =========================================================================
// STEP 3: CONVEYOR B ZPA CHAIN (6 ZONES)
// =========================================================================

// --- ZONE B1 (Module B1, Motor A) --- Infeed from Gravity Roller Y
fbZoneB1(
    bEnable             := fbSystemControl.bSystemEnable,
    bTandemMode         := bTandem,
    bIsTandemSlave      := FALSE,
    bPE                 := stB1_In.bSensorA,
    bJogOverride        := stControlPanel_In.bFootswitch2, // Pulls from Gravity Roller Y
    bUpstreamArrival    := stControlPanel_In.bFootswitch2,
    bDownstreamOccupied := SEL(bTandem, fbZoneB2.bOccupied, fbZoneB3.bOccupied),
    bDownstreamReady    := SEL(bTandem, fbZoneB2.bReadyToReceive, fbZoneB3.bReadyToReceive),
    bTandemSlavePE      := stB2_In.bSensorA,
	bReset := fbSystemControl.bResetFaults
);

// --- ZONE B2 (Module B2, Motor B) ---
fbZoneB2(
    bEnable             := fbSystemControl.bSystemEnable,
    bTandemMode         := bTandem,
    bIsTandemSlave      := TRUE,
    bPE                 := stB2_In.bSensorA,
    bUpstreamArrival    := fbZoneB1.bOccupied,
    bDownstreamOccupied := fbZoneB3.bOccupied,
    bDownstreamReady    := fbZoneB3.bReadyToReceive,
    bTandemMasterRun    := fbZoneB1.bRunMotor,
	bReset := fbSystemControl.bResetFaults
);

// --- ZONE B3 (Module B2, Motor A) ---
fbZoneB3(
    bEnable             := fbSystemControl.bSystemEnable,
    bTandemMode         := bTandem,
    bIsTandemSlave      := FALSE,
    bPE                 := stB2_In.bSensorB,
    bUpstreamArrival    := fbZoneB2.bOccupied,
    bDownstreamOccupied := SEL(bTandem, fbZoneB4.bOccupied, fbZoneB5.bOccupied),
    bDownstreamReady    := SEL(bTandem, fbZoneB4.bReadyToReceive, fbZoneB5.bReadyToReceive),
    bTandemSlavePE      := stB3_In.bSensorA,
	bReset := fbSystemControl.bResetFaults
);

// --- ZONE B4 (Module B3, Motor A) ---
fbZoneB4(
    bEnable             := fbSystemControl.bSystemEnable,
    bTandemMode         := bTandem,
    bIsTandemSlave      := TRUE,
    bPE                 := stB3_In.bSensorA,
    bUpstreamArrival    := fbZoneB3.bOccupied,
    bDownstreamOccupied := fbZoneB5.bOccupied,
    bDownstreamReady    := fbZoneB5.bReadyToReceive,
    bTandemMasterRun    := fbZoneB3.bRunMotor,
	bReset := fbSystemControl.bResetFaults
);
// --- ZONE B5 (Module B4, Motor B) ---
fbZoneB5(
    bEnable             := fbSystemControl.bSystemEnable,
    bTandemMode         := bTandem,
    bIsTandemSlave      := FALSE,
    bPE                 := stB4_In.bSensorA,
    bUpstreamArrival    := fbZoneB4.bOccupied,
    bDownstreamOccupied := SEL(bTandem, fbZoneB6.bOccupied, TRUE),                           // In Tandem Mode, EOL B is occupied
    bDownstreamReady    := SEL(bTandem, fbZoneB6.bReadyToReceive, stControlPanel_In.bFootswitch2), // In Tandem Mode, wait for footswitch 2
    bTandemSlavePE      := stB4_In.bSensorB,
	bReset := fbSystemControl.bResetFaults
);

// --- ZONE B6 (Module B4, Motor A) --- End of Line B Discharge Zone
fbZoneB6(
    bEnable             := fbSystemControl.bSystemEnable,
    bTandemMode         := bTandem,
    bIsTandemSlave      := SEL(bTandem, FALSE, TRUE),
    bPE                 := stB4_In.bSensorB,
    bJogOverride        := stB4_In.bRemoteIn1,
    bUpstreamArrival    := fbZoneB5.bOccupied,
    bDownstreamOccupied := TRUE,
    bDownstreamReady    := stB4_In.bRemoteIn1,
    bTandemMasterRun    := fbZoneB5.bRunMotor,
    tStopDelay          := T#0S,
	bReset := fbSystemControl.bResetFaults
);

// =========================================================================
// STEP 4: HARDWARE MOTOR OUTPUT MAP
// =========================================================================

// Module A1 (1 Motor: Zone A1)
stA1_Out.bRunMotorA := fbZoneA1.bRunMotor;

// Module A2 (2 Motors: Motor A = Zone A3, Motor B = Zone A2)
stA2_Out.bRunMotorA := fbZoneA3.bRunMotor;
stA2_Out.bRunMotorB := fbZoneA2.bRunMotor;

// Module A3 (1 Motor: Zone A4)
stA3_Out.bRunMotorA := fbZoneA4.bRunMotor;

// Module A4 (2 Motors: Motor A = Zone A6, Motor B = Zone A5)
stA4_Out.bRunMotorA := fbZoneA6.bRunMotor;
stA4_Out.bRunMotorB := fbZoneA5.bRunMotor;

// Module A5 (1 Motor: Zone A7)
stA5_Out.bRunMotorA := fbZoneA7.bRunMotor;

// Module A6 (2 Motors: Motor A = Zone A9, Motor B = Zone A8)
stA6_Out.bRunMotorA := fbZoneA9.bRunMotor;
stA6_Out.bRunMotorB := fbZoneA8.bRunMotor;

// Module A7 (1 Motor: Zone A10)
stA7_Out.bRunMotorA := fbZoneA10.bRunMotor;

// Module A8 (2 Motors: Motor A = Zone A12, Motor B = Zone A11)
stA8_Out.bRunMotorA := fbZoneA12.bRunMotor;
stA8_Out.bRunMotorB := fbZoneA11.bRunMotor;

// -------------------------------------------------------------------------
// Conveyor B Output Mapping
// -------------------------------------------------------------------------

// Module B1 (1 Motor: Zone B1)
stB1_Out.bRunMotorA := fbZoneB1.bRunMotor;

// Module B2 (2 Motors: Motor A = Zone B3, Motor B = Zone B2)
stB2_Out.bRunMotorA := fbZoneB3.bRunMotor;
stB2_Out.bRunMotorB := fbZoneB2.bRunMotor;

// Module B3 (1 Motor: Zone B4)
stB3_Out.bRunMotorA := fbZoneB4.bRunMotor;

// Module B4 (2 Motors: Motor A = Zone B6, Motor B = Zone B5)
stB4_Out.bRunMotorA := fbZoneB6.bRunMotor;
stB4_Out.bRunMotorB := fbZoneB5.bRunMotor;

ACT_MapIO();]]></ST>
    </Implementation>
    <Action Name="ACT_MapIO" Id="{c9d901b9-7f5e-4159-95dd-6f673401d37d}">
      <Implementation>
        <ST><![CDATA[// =========================================================================
// CONVEYOR A - MODULE A1
// =========================================================================
// Inputs
stA1_In.bSensorA             := stA1_InBytes[4].0;
stA1_In.bSensorB             := stA1_InBytes[4].1;
stA1_In.bSensorAlarmA        := stA1_InBytes[4].2;
stA1_In.bSensorAlarmB        := stA1_InBytes[4].3;
stA1_In.bMotorARunning       := stA1_InBytes[4].4;
stA1_In.bMotorBRunning       := stA1_InBytes[4].5;

stA1_In.bErrMotorA_BackEMF   := stA1_InBytes[5].0;
stA1_In.bErrMotorA_Current   := stA1_InBytes[5].1;
stA1_In.bErrMotorA_Thermal   := stA1_InBytes[5].2;
stA1_In.bErrDriverA_Thermal  := stA1_InBytes[5].3;
stA1_In.bErrMotorA_Stalled   := stA1_InBytes[5].4;
stA1_In.bErrMotorA_Unplugged := stA1_InBytes[5].5;
stA1_In.bErrMotorA_Jam       := stA1_InBytes[5].6;
stA1_In.bErrMotorA_Sensor    := stA1_InBytes[5].7;

stA1_In.bErrMotorB_BackEMF   := stA1_InBytes[6].0;
stA1_In.bErrMotorB_Current   := stA1_InBytes[6].1;
stA1_In.bErrMotorB_Thermal   := stA1_InBytes[6].2;
stA1_In.bErrDriverB_Thermal  := stA1_InBytes[6].3;
stA1_In.bErrMotorB_Stalled   := stA1_InBytes[6].4;
stA1_In.bErrMotorB_Unplugged := stA1_InBytes[6].5;
stA1_In.bErrMotorB_Jam       := stA1_InBytes[6].6;
stA1_In.bErrMotorB_Sensor    := stA1_InBytes[6].7;

stA1_In.bRemoteIn1           := stA1_InBytes[7].0;
stA1_In.bRemoteIn2           := stA1_InBytes[7].1;
stA1_In.bRemoteIn3           := stA1_InBytes[7].2;



// Outputs
stA1_OutBytes[0].0 := stA1_Out.bRunMotorA;
stA1_OutBytes[0].1 := stA1_Out.bRunMotorB;

stA1_OutBytes[1].0 := stA1_Out.bSpeed1_MotorA;
stA1_OutBytes[1].1 := stA1_Out.bSpeed2_MotorA;
stA1_OutBytes[1].2 := stA1_Out.bSpeed3_MotorA;
stA1_OutBytes[1].3 := stA1_Out.bSpeed4_MotorA;
stA1_OutBytes[1].4 := stA1_Out.bSpeed1_MotorB;
stA1_OutBytes[1].5 := stA1_Out.bSpeed2_MotorB;
stA1_OutBytes[1].6 := stA1_Out.bSpeed3_MotorB;
stA1_OutBytes[1].7 := stA1_Out.bSpeed4_MotorB;

